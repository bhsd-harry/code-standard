{
	"name": "@bhsd/code-standard",
	"version": "4.1.0",
	"homepage": "https://github.com/bhsd-harry/code-standard#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/code-standard/issues"
	},
	"license": "MIT",
	"author": "Bhsd",
	"files": [
		"*.js",
		"!eslint.config.js",
		"markdownlint.json"
	],
	"main": "eslint.js",
	"exports": {
		".": "./eslint.js",
		"./stylelint": "./stylelintrc.js",
		"./markdownlint": "./markdownlint.json"
	},
	"type": "module",
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"lint:ts": "eslint --cache .",
		"lint": "npm run lint:ts"
	},
	"peerDependencies": {
		"eslint": "^10.0.0",
		"markdownlint-cli2": ">=0.7.0",
		"stylelint": ">=17.10.0"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		},
		"markdownlint-cli2": {
			"optional": true
		},
		"stylelint": {
			"optional": true
		}
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-plugin": "^5.3.0",
		"@types/node": "^26.2.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"eslint-plugin-es-x": "^10.0.0",
		"eslint-plugin-jsdoc": "^64.1.0",
		"eslint-plugin-jsonc": "^3.4.1",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.1.1",
		"eslint-plugin-unicorn": "^73.0.0",
		"eslint-plugin-yml": "^3.8.1",
		"globals": "^17.9.0",
		"stylelint-plugin-use-baseline": "^1.4.5",
		"stylelint-config-recommended": "^18.0.0"
	},
	"devDependencies": {
		"eslint": "^10.8.1"
	}
}
