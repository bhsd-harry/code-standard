{
	"name": "@bhsd/code-standard",
	"version": "5.0.0",
	"homepage": "https://github.com/bhsd-harry/code-standard#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/code-standard/issues"
	},
	"license": "MIT",
	"author": "Bhsd",
	"files": [
		"*.js",
		"!eslint.config.js",
		"markdownlint.json"
	],
	"main": "eslint.js",
	"exports": {
		".": "./eslint.js",
		"./stylelint": "./stylelintrc.js",
		"./markdownlint": "./markdownlint.json"
	},
	"type": "module",
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"lint:ts": "eslint --cache .",
		"lint:md": "myMarkdownlint",
		"lint": "npm run lint:ts && npm run lint:md"
	},
	"bin": {
		"myMarkdownlint": "markdownlint-cli.js"
	},
	"peerDependencies": {
		"eslint": "^10.0.0",
		"stylelint": ">=17.10.0"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		},
		"stylelint": {
			"optional": true
		}
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-plugin": "^5.3.1",
		"@types/node": "^26.6.2",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"eslint-plugin-es-x": "^10.0.1",
		"eslint-plugin-jsdoc": "^65.2.1",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-n": "^18.4.1",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-unicorn": "^77.0.0",
		"eslint-plugin-yml": "^3.9.0",
		"globals": "^17.13.0",
		"markdownlint": "^0.41.1",
		"stylelint-plugin-use-baseline": "^1.4.6",
		"stylelint-config-recommended": "^18.0.0"
	},
	"devDependencies": {
		"eslint": "^10.12.0"
	},
	"engines": {
		"node": "^26.0.0"
	}
}
