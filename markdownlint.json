{
	"descriptive-link-text": false,
	"first-line-h1": {
		"allow_preamble": true
	},
	"line-length": {
		"code_blocks": false,
		"tables": false
	},
	"no-bare-urls": false,
	"no-emphasis-as-heading": false,
	"no-hard-tabs": false,
	"no-inline-html": {
		"allowed_elements": [
			"br",
			"details",
			"summary"
		]
	},
	"ul-indent": {
		"indent": 1
	}
}
